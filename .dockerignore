**/node_modules
.git
.github

# Agent state and local-only migration/rehearsal material are never build inputs.
.sks
/tmp
/temp
/artifact
/artifacts
/rehearsal
/rehearsals

# Keep production snapshots and generated migration manifests out even if they
# are moved outside the local .sks workspace in a future rehearsal.
**/*.dump
**/writes.ndjson
/migration/**/runs
/migration/**/rehearsal
/migration/**/rehearsals
/migration/**/source-manifest.json
/migration/**/source-object-manifest.json
/migration/**/dispositions.ndjson
/migration/**/exceptions.ndjson

