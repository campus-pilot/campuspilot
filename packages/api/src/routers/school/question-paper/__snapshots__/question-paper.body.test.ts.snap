exports[`the built-in examples > render english-science deterministically 1`] = `"<div class="qp-body qp-script-latin" lang="en" dir="ltr"><ul class="qp-instructions"><li>All questions are compulsory.</li><li>Draw neat, labelled diagrams wherever required.</li></ul><section class="qp-section"><h2 class="qp-section-heading">Section A: Multiple choice</h2><ul class="qp-instructions"><li>Each question carries 1 mark.</li></ul><div class="qp-question qp-keep"><span class="qp-number">1</span><div class="qp-content"><div class="qp-text">Which gas is released during photosynthesis?</div><ol class="qp-options"><li class="qp-option"><span class="qp-option-label">a</span><div class="qp-option-body">Carbon dioxide</div></li><li class="qp-option"><span class="qp-option-label">b</span><div class="qp-option-body">Oxygen</div></li><li class="qp-option"><span class="qp-option-label">c</span><div class="qp-option-body">Nitrogen</div></li><li class="qp-option"><span class="qp-option-label">d</span><div class="qp-option-body">Hydrogen</div></li></ol></div><span class="qp-marks">[1]</span></div><div class="qp-question qp-keep"><span class="qp-number">2</span><div class="qp-content"><div class="qp-text">The chemical formula of water is <span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.8333em;vertical-align:-0.15em;"></span><span class="mord"><span class="mord"><span class="mord mathrm">H</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3011em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathrm mtight">2</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mord mathrm">O</span></span></span></span></span></span>. It contains:</div><ol class="qp-options"><li class="qp-option"><span class="qp-option-label">a</span><div class="qp-option-body">2 atoms of hydrogen</div></li><li class="qp-option"><span class="qp-option-label">b</span><div class="qp-option-body">2 atoms of oxygen</div></li><li class="qp-option"><span class="qp-option-label">c</span><div class="qp-option-body">1 atom of hydrogen</div></li><li class="qp-option"><span class="qp-option-label">d</span><div class="qp-option-body">3 atoms of oxygen</div></li></ol></div><span class="qp-marks">[1]</span></div></section><section class="qp-section"><h2 class="qp-section-heading">Section B: Short answer</h2><ul class="qp-instructions"><li>Each question carries 2 marks.</li></ul><div class="qp-question qp-keep"><span class="qp-number">3</span><div class="qp-content"><div class="qp-text">The process of conversion of water vapour into liquid water is called ________.</div></div><span class="qp-marks">[2]</span></div><div class="qp-question qp-keep"><span class="qp-number">4</span><div class="qp-content"><div class="qp-text">Complete the table of states of matter.</div><table class="qp-table"><thead><tr><th>Substance</th><th>State at room temperature</th></tr></thead><tbody><tr><td>Iron</td><td>Solid</td></tr><tr><td>Mercury</td><td>________</td></tr></tbody></table></div><span class="qp-marks">[2]</span></div></section><section class="qp-section"><h2 class="qp-section-heading">Section C: Long answer</h2><div class="qp-question"><span class="qp-number">5</span><div class="qp-content"><div class="qp-text">Answer the following about the human digestive system.</div><div class="qp-part"><span class="qp-number">(a)</span><div class="qp-content"><div class="qp-text">Name the organ where most digestion is completed.</div></div><span class="qp-marks">[2]</span></div><div class="qp-part"><span class="qp-number">(b)</span><div class="qp-content"><div class="qp-text">Describe the role of the liver and the pancreas in digestion.</div></div><span class="qp-marks">[4]</span></div></div><span class="qp-marks">[6]</span></div><div class="qp-question"><span class="qp-number">6</span><div class="qp-content"><div class="qp-text">State two differences between a plant cell and an animal cell.</div><div class="qp-or">OR</div><div class="qp-alternative"><div class="qp-content"><div class="qp-text">Explain why mitochondria are called the powerhouse of the cell.</div></div><span class="qp-marks">[4]</span></div></div><span class="qp-marks">[4]</span></div><div class="qp-question qp-keep"><span class="qp-number">7</span><div class="qp-content"><div class="qp-text">Draw a labelled diagram of the human heart.</div><figure class="qp-figure qp-figure-placeholder" style="width:60%"><div>Figure to be added</div><div>Hand-drawn labelled diagram of the human heart showing four chambers, aorta and vena cava</div></figure></div><span class="qp-marks">[4]</span></div></section></div>"`;

exports[`the built-in examples > render hindi-math deterministically 1`] = `
"<div class="qp-body qp-script-devanagari" lang="hi" dir="ltr"><ul class="qp-instructions"><li>सभी प्रश्न अनिवार्य हैं।</li><li>प्रश्नों के अंक उनके सामने दिए गए हैं।</li></ul><section class="qp-section"><h2 class="qp-section-heading">खंड अ</h2><ul class="qp-instructions"><li>प्रत्येक प्रश्न 1 अंक का है। सही विकल्प चुनिए।</li></ul><div class="qp-question qp-keep"><span class="qp-number">1</span><div class="qp-content"><div class="qp-text">समीकरण <span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.7278em;vertical-align:-0.0833em;"></span><span class="mord">2</span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">3</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">11</span></span></span></span></span> का हल है:</div><ol class="qp-options"><li class="qp-option"><span class="qp-option-label">(क)</span><div class="qp-option-body"><span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.4306em;"></span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">2</span></span></span></span></span></div></li><li class="qp-option"><span class="qp-option-label">(ख)</span><div class="qp-option-body"><span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.4306em;"></span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">4</span></span></span></span></span></div></li><li class="qp-option"><span class="qp-option-label">(ग)</span><div class="qp-option-body"><span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.4306em;"></span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">7</span></span></span></span></span></div></li><li class="qp-option"><span class="qp-option-label">(घ)</span><div class="qp-option-body"><span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.4306em;"></span><span class="mord mathnormal">x</span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">14</span></span></span></span></span></div></li></ol></div><span class="qp-marks">[1]</span></div><div class="qp-question qp-keep"><span class="qp-number">2</span><div class="qp-content"><div class="qp-text">भुजा <span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:0.6444em;"></span><span class="mord">6</span></span></span></span></span> सेमी वाले वर्ग का क्षेत्रफल (वर्ग सेमी में) है:</div><ol class="qp-options"><li class="qp-option"><span class="qp-option-label">(क)</span><div class="qp-option-body">12</div></li><li class="qp-option"><span class="qp-option-label">(ख)</span><div class="qp-option-body">24</div></li><li class="qp-option"><span class="qp-option-label">(ग)</span><div class="qp-option-body">36</div></li><li class="qp-option"><span class="qp-option-label">(घ)</span><div class="qp-option-body">72</div></li></ol></div><span class="qp-marks">[1]</span></div></section><section class="qp-section"><h2 class="qp-section-heading">खंड ब</h2><div class="qp-question qp-keep"><span class="qp-number">3</span><div class="qp-content"><div class="qp-text">हल कीजिए: <span class="qp-math"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height:1.0404em;vertical-align:-0.345em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.6954em;"><span style="top:-2.655em;"><span class="pstrut" style="height:3em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight">3</span></span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.394em;"><span class="pstrut" style="height:3em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">x</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.345em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="base"><span class="strut" style="height:1.04em;vertical-align:-0.1328em;"></span><span class="mord sqrt"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.9072em;"><span class="svg-align" style="top:-3em;"><span class="pstrut" style="height:3em;"></span><span class="mord" style="padding-left:0.833em;"><span class="mord">16</span></span></span><span style="top:-2.8672em;"><span class="pstrut" style="height:3em;"></span><span class="hide-tail" style="min-width:0.853em;height:1.08em;"><svg xmlns="http://www.w3.org/2000/svg" width="400em" height="1.08em" viewBox="0 0 400000 1080" preserveAspectRatio="xMinYMin slice"><path d="M95,702
