CORS_ORIGIN=http://localhost:3002
ASSISTANT_PORT=3104
ASSISTANT_DATABASE_URL=postgresql://postgres:password@localhost:5432/campuspilot
REDIS_URL=redis://localhost:6379
CAMPUSPILOT_API_URL=http://localhost:3000
CAMPUSPILOT_MCP_URL=http://localhost:3000/mcp
# Same value as ASSISTANT_SERVICE_SECRET in apps/server/.env
ASSISTANT_SERVICE_SECRET=replace-with-at-least-32-characters
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_SERVICE_PORT=9081
RESTATE_SERVICE_URL=http://host.docker.internal:9081
# Provider for new conversations: anthropic or gemini.
ASSISTANT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# Required when ASSISTANT_PROVIDER=gemini, for example a current Gemini Pro model id.
GEMINI_MODEL=

# Developer-only: shows each turn's model, token usage, estimated cost and
# raw errors in the chat. Never enable for real users.
ASSISTANT_DIAGNOSTICS=false
