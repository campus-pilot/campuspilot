{
  "name": "assistant",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch src/index.ts",
