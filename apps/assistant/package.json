    "@campuspilot/redis": "workspace:*",
    "@campuspilot/restate": "workspace:*",
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/client": "^2.4.0",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@restatedev/restate-sdk": "^1.18.3",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
