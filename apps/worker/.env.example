# The worker runs the demo-school workflows, which use the API's services.
# Copy apps/server/.env here, then add the worker's own settings below.

WORKER_PORT=9080
# The URI Restate (running in Docker) uses to reach this worker on the host.
RESTATE_WORKER_URL=http://host.docker.internal:9080
# Verifies calls to worker services on Restate ingress; must equal the API
# server's value. Required in production. Generate with: openssl rand -hex 32
WORKER_CONTROL_SECRET=

# The worker sends notifications, so it needs the API's channel settings
# (copied above with apps/server/.env): WEB_PUSH_ENABLED, VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, VAPID_SUBJECT.
