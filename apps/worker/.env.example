# The worker runs the demo-school workflows, which use the API's services.
# Copy apps/server/.env here, then add the worker's own settings below.

WORKER_PORT=9080
# The URI Restate (running in Docker) uses to reach this worker on the host.
RESTATE_WORKER_URL=http://host.docker.internal:9080
# Verifies calls to worker services on Restate ingress; must equal the API
# server's value. Required in production. Generate with: openssl rand -hex 32
WORKER_CONTROL_SECRET=

# The worker sends notifications, so it needs the API's channel settings
# (copied above with apps/server/.env): WEB_PUSH_ENABLED, VAPID_PUBLIC_KEY,
# VAPID_PRIVATE_KEY, VAPID_SUBJECT, WEB_PUSH_SEND_RATE_PER_SECOND and
# WHATSAPP_* incl. WHATSAPP_SEND_RATE_PER_SECOND and the optional
# WHATSAPP_GRAPH_BASE_URL (the webhook values are only
# used by the API server).

# The worker runs the in-app assistant's turns, so it needs the assistant
# settings copied above with apps/server/.env: ASSISTANT_PROVIDER, the
# provider's <P>_API_KEY, <P>_MODEL and four <P>_PRICE_*_USD_PER_MTOK, and
# CAMPUSPILOT_MCP_URL (the API's /mcp as this worker reaches it; required
# while a provider is configured). It does not need
# ASSISTANT_TOKEN_SIGNING_SECRET: the API issues the tokens.

# The worker also runs question paper generation, so it needs the same
# QUESTION_PAPER_PROVIDER, QUESTION_PAPER_MODEL, QUESTION_PAPER_PRICE_* and
# QUESTION_PAPER_MAX_OUTPUT_TOKENS as apps/server/.env (all optional; they fall
# back to the assistant's provider, model and prices) and the provider's API key.
