# The worker runs the demo-school workflows, which use the API's services.
# Copy apps/server/.env here, then add the worker's own settings below.

WORKER_PORT=9080
# The URI Restate (running in Docker) uses to reach this worker on the host.
RESTATE_WORKER_URL=http://host.docker.internal:9080
# Restate request signing keys (publickeyv1_…), comma-separated. Required in
# production; leave unset in local dev to accept unsigned requests.
# RESTATE_IDENTITY_KEYS=
# Verifies DemoSchoolControl calls; must equal the API server's value.
# Required in production. Generate with: openssl rand -hex 32
DEMO_CONTROL_SECRET=
