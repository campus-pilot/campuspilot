{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@campuspilot/api": "workspace:*",
    "@campuspilot/assistant": "workspace:*",
    "@campuspilot/assistant-contract": "workspace:*",
    "@campuspilot/auth": "workspace:*",
    "@campuspilot/db": "workspace:*",
    "@campuspilot/env": "workspace:*",
    "@campuspilot/logger": "workspace:*",
    "@campuspilot/redis": "workspace:*",
    "@campuspilot/s3": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/server": "^2.4.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "hono-rate-limiter": "0.5.4",
    "ioredis": "^5.11.1",
    "sharp": "^0.34.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@campuspilot/config": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "catalog:",
    "drizzle-orm": "^0.45.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "4.1.4"
  }
}
