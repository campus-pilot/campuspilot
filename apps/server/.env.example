BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/mcp
# Cadet Portal (apps/cadet): its origin and the cadet MCP endpoint. The cadet
# origin is trusted only by the cadet auth instance; keep it out of CORS_ORIGIN.
CADET_APP_URL=http://localhost:3004
CADET_MCP_RESOURCE_URL=http://localhost:3000/cadet/mcp
SERVER_PORT=3000
SYSTEM_ADMIN_EMAIL=admin@example.com
CORS_ORIGIN=http://localhost:3001,http://localhost:3003,http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/campuspilot

# Local RustFS. Keep these S3_* keys for production AWS S3 as well.
# For AWS S3, omit S3_ENDPOINT and use S3_FORCE_PATH_STYLE=false.
S3_ACCESS_KEY_ID=RUSTFSLOCALDEV
S3_BUCKET=campuspilot
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=campuspilot-local-rustfs

GOTENBERG_URL=http://localhost:8781
OPA_URL=http://localhost:8181
REDIS_URL=redis://localhost:6379
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_FABRIC_URL=http://localhost:5122
RESTATE_INGRESS_URL=http://localhost:8080


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBLIC_APP_URL=http://localhost:3001

# Signs calls to worker services on Restate ingress (HMAC-SHA256); the worker
# needs the same value. Required in production. Generate with: openssl rand -hex 32
WORKER_CONTROL_SECRET=

# Web push from the installed Cadet Portal. Off by default and locally; while
# off every push copy is recorded as skipped (disabled). When true, all three
# VAPID values are required. Generate the key pair once per environment with:
#   npx web-push generate-vapid-keys
# and put the public key into the Cadet Portal's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: or https: URL.
VAPID_SUBJECT=
# Pushes each of the four sender lanes starts per second (worker). Default 50.
# WEB_PUSH_SEND_RATE_PER_SECOND=50

# WhatsApp Business Cloud API (one CampusPilot number for every school).
# Sending is off by default and locally; while off every WhatsApp copy is
# recorded as skipped (disabled). When true, every value below is required.
WHATSAPP_ENABLED=false
# Permanent System User token (whatsapp_business_messaging +
# whatsapp_business_management): Business settings → Users → System users.
WHATSAPP_ACCESS_TOKEN=
# App → WhatsApp → API Setup (numeric IDs).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App settings → Basic → App secret; verifies webhook signatures.
WHATSAPP_APP_SECRET=
# A random value you choose (openssl rand -hex 24) and enter in the app's
# webhook configuration. The webhook (/webhooks/whatsapp) works whenever
# this and WHATSAPP_APP_SECRET are set, even with sending switched off.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Pinned Graph API version, e.g. v24.0.
WHATSAPP_GRAPH_API_VERSION=
# Messages the worker's WhatsApp sender starts per second on the one number.
# Default 20 (Meta's default throughput is 80/s). Optional.
# WHATSAPP_SEND_RATE_PER_SECOND=20
# Graph API host the client calls. Optional, default Meta's host; only set it
# to point a non-production stack at a Cloud API mock (https, or http on
# localhost outside production).
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# In-app assistant (packages/assistant): the API serves /model/*, issues and
# verifies the delegated tokens; apps/worker runs the turns (copy this file
# there). Signs the delegated MCP tokens; leave empty to keep the assistant
# off (the API then issues and accepts no assistant token). Generate your own
# value, never reuse an example: openssl rand -hex 32
ASSISTANT_TOKEN_SIGNING_SECRET=
# Provider for new conversations: gemini or anthropic. A provider is
# configured only when its key, model and all four prices (USD per 1M tokens)
# are set; a provider with only some of them refuses to start. Prices are
# saved with every model request; update them when the provider changes its
# prices (Gemini 3.8 Flash Standard: 1.50 / 7.50 / 0.15 / 0 from 2027-01-01).
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRICE_INPUT_USD_PER_MTOK=0.75
GEMINI_PRICE_OUTPUT_USD_PER_MTOK=3.75
GEMINI_PRICE_CACHE_READ_USD_PER_MTOK=0.075
GEMINI_PRICE_CACHE_WRITE_USD_PER_MTOK=0
# Anthropic, when used: all six or none.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_PRICE_INPUT_USD_PER_MTOK=2
# ANTHROPIC_PRICE_OUTPUT_USD_PER_MTOK=10
# ANTHROPIC_PRICE_CACHE_READ_USD_PER_MTOK=0.2
# ANTHROPIC_PRICE_CACHE_WRITE_USD_PER_MTOK=2.5
# The API's MCP endpoint as the worker reaches it (internal address + /mcp).
# Required by the worker while a provider is configured.
CAMPUSPILOT_MCP_URL=http://localhost:3000/mcp
# Question paper generation ("Generate with AI", run by the worker). It uses the
# assistant's provider, model and prices above unless you set these. With
# QUESTION_PAPER_MODEL set, all four QUESTION_PAPER_PRICE_* are required (a
# model never inherits another model's prices); without it they must be unset.
# QUESTION_PAPER_PROVIDER needs that provider's API key. Reading handwriting
# from photographs is where a stronger model pays off.
# QUESTION_PAPER_PROVIDER=gemini
# QUESTION_PAPER_MODEL=
# QUESTION_PAPER_PRICE_INPUT_USD_PER_MTOK=
# QUESTION_PAPER_PRICE_OUTPUT_USD_PER_MTOK=
# QUESTION_PAPER_PRICE_CACHE_READ_USD_PER_MTOK=
# QUESTION_PAPER_PRICE_CACHE_WRITE_USD_PER_MTOK=
# Output token limit of one generation request (default 32000).
# QUESTION_PAPER_MAX_OUTPUT_TOKENS=32000
# Minutes a running generation may take before the API fails it (default 40, above the worst case of two
# long model requests so the sweep never fails a job that is still being billed).
# The API server reads this one; the worker ignores it.
# QUESTION_PAPER_JOB_TIMEOUT_MINUTES=40
# Most generation jobs (queued plus running) one school may have at once
# (default 3). Bounds how far the cached monthly-spend check can be overshot.
# QUESTION_PAPER_MAX_RUNNING_JOBS_PER_SCHOOL=3
# Developer-only: shows each turn's model, token usage, saved cost and raw
# errors in the chat to every user. Never enable for real users.
ASSISTANT_DIAGNOSTICS=false
