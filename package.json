{
  "name": "campuspilot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "test": "turbo run test",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:management": "turbo run dev -F management --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @campuspilot/db --",
    "db:studio": "turbo run db:studio -F @campuspilot/db --",
    "db:generate": "turbo run db:generate -F @campuspilot/db --",
    "db:migrate": "turbo run db:migrate -F @campuspilot/db --",
    "db:start": "docker compose -f docker/dev/compose.yml up -d postgres",
    "db:watch": "docker compose -f docker/dev/compose.yml up postgres",
    "db:stop": "docker compose -f docker/dev/compose.yml stop postgres",
    "db:down": "docker compose -f docker/dev/compose.yml down",
    "docker:build": "docker compose -f docker/dev/compose.yml build",
    "docker:up": "docker compose -f docker/dev/compose.yml up -d",
    "docker:rebuild": "docker compose -f docker/dev/compose.yml up -d --build --force-recreate",
    "docker:down": "docker compose -f docker/dev/compose.yml down",
    "docker:logs": "docker compose -f docker/dev/compose.yml logs -f"
  },
  "dependencies": {
    "@campuspilot/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@campuspilot/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}
